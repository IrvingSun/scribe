#!/bin/bash
# Write a proposed memory card. This command never writes approved memory.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/common.sh"
scribe_ensure_data_dir

python3 - "$SCRIBE_DATA_DIR" "$@" <<'PY'
import datetime as dt
import pathlib
import re
import secrets
import sys

data_dir = pathlib.Path(sys.argv[1])
args = sys.argv[2:]
allowed_types = {
    "project_fact", "decision", "preference", "correction",
    "decision_change", "fact_supersession",
}
required = {"type", "claim", "evidence", "scope", "not-covered", "invalidated-by", "future-use"}
allowed_keys = required | {"project", "replaces", "new-statement"}
values = {}
i = 0
while i < len(args):
    arg = args[i]
    if not arg.startswith("--") or i + 1 >= len(args):
        raise SystemExit("usage: record-candidate --type TYPE --claim TEXT --evidence TEXT --scope TEXT --not-covered TEXT --invalidated-by TEXT --future-use TEXT [--project PATH] [--replaces CARD_ID] [--new-statement TEXT]")
    values[arg[2:]] = args[i + 1]
    i += 2

unknown = sorted(set(values) - allowed_keys)
if unknown:
    raise SystemExit("unknown fields: " + ", ".join(unknown))
missing = [key for key in required if not values.get(key, "").strip()]
if missing:
    raise SystemExit("missing required fields: " + ", ".join(sorted(missing)))
if values["type"] not in allowed_types:
    raise SystemExit("invalid type: " + values["type"])
for key, value in values.items():
    if "\n" in value or "\r" in value:
        raise SystemExit(f"field must be one line: {key}")
if values["type"] == "decision_change":
    extra = [key for key in ("replaces", "new-statement") if not values.get(key, "").strip()]
    if extra:
        raise SystemExit("decision_change requires: " + ", ".join(extra))
if values["type"] == "fact_supersession" and not values.get("replaces", "").strip():
    raise SystemExit("fact_supersession requires: replaces")
if values["type"] in {"decision_change", "fact_supersession"}:
    replaced = data_dir / "approved" / f"{values['replaces']}.md"
    if not replaced.is_file():
        raise SystemExit("replaces must name an active approved card: " + values["replaces"])

evidence = values["evidence"]
if values["type"] in {"project_fact", "fact_supersession"}:
    if not re.search(r"\S+:\d+|(?:命令|command|数据源|日志|log|查询|query)\s*[:：]", evidence, re.I):
        raise SystemExit("fact evidence must include file:line, a command, or a named data source")
elif not re.search(r"用户|user", evidence, re.I):
    raise SystemExit("decision/preference evidence must identify the user statement")

def normalized_claim(text):
    return " ".join(text.casefold().split())

claim = normalized_claim(values["claim"])
for directory in (data_dir / "candidates", data_dir / "approved"):
    for card in directory.glob("*.md"):
        for line in card.read_text(encoding="utf-8").splitlines():
            if line.startswith("- 主张: ") and normalized_claim(line[6:]) == claim:
                raise SystemExit("duplicate claim already recorded: " + card.stem)

now = dt.datetime.now(dt.timezone.utc)
card_id = f"SCR-{now:%Y%m%d}-{secrets.token_hex(3).upper()}"
target = data_dir / "candidates"
target.mkdir(parents=True, exist_ok=True)
path = target / f"{card_id}.md"

def field(name, label):
    value = values.get(name, "").strip()
    return f"- {label}: {value}\n" if value else ""

body = (
    f"# {card_id}\n\n"
    f"- 状态: candidate\n"
    f"- 类型: {values['type']}\n"
    f"- 创建时间: {now.isoformat()}\n"
    + field("project", "项目")
    + field("claim", "主张")
    + field("evidence", "证据")
    + field("scope", "适用范围")
    + field("not-covered", "不涵盖")
    + field("invalidated-by", "失效条件")
    + field("future-use", "未来用途")
    + field("replaces", "替代/复核的旧记录")
    + field("new-statement", "用户最新表述")
)
path.write_text(body, encoding="utf-8")
print(f"已写入候选记录: {card_id} ({path})")
PY
